  "libraries": [],
  "components": [
    {
      "name": "ActionBar",
      "group": "Aksi",
      "summary": "Dock 3 x 2 berisi enam ActionButton di bagian bawah PetScreen, selalu dalam urutan yang sama."
    },
    {
      "name": "ActionButton",
      "group": "Aksi",
      "summary": "Satu dari enam aksi rawat (Makan, Camilan, Main, Bersihkan, Obat, Lampu), digambar sebagai tombol mainan yang turun saat ditekan."
    },
    {
      "name": "Button",
      "group": "Aksi",
      "summary": "Tombol berlabel untuk keputusan di luar aksi rawat: Jemput Tama, Lihat Tama, Nanti saja."
    },
    {
      "name": "EvolutionReveal",
      "group": "Momen",
      "summary": "Momen kejutan satu layar saat app dibuka dan pet ternyata sudah berevolusi selama app tertutup (P0-5)."
    },
    {
      "name": "Pet",
      "group": "Karakter",
      "summary": "Gambar pet yang dilukis PetPainter (CustomPainter) dari bentuk geometri saja: tubuh persegi bulat, dua kaki oval, mata, mulut, dan pipi."
    },
    {
      "name": "PetScreen",
      "group": "Layar",
      "summary": "Satu-satunya layar utama: StageBadge dan tombol pengaturan di atas, ruang pet di tengah, dua StatusMeter, lalu ActionBar di bawah."
    },
    {
      "name": "StageBadge",
      "group": "Status",
      "summary": "Pil kecil di kiri atas PetScreen yang menunjukkan tahap hidup dan umur pet, atau jam bangun saat pet tidur."
    },
    {
      "name": "StatusMeter",
      "group": "Status",
      "summary": "Meter Kenyang atau Senang dalam lima pip, seperti hati pada Tamagotchi asli, sehingga anak bisa membacanya tanpa angka."
    },
    {
      "name": "VacationNote",
      "group": "Momen",
      "summary": "Catatan bertempel selotip yang menggantikan pet setelah 48 jam tanpa perawatan: pet pergi berlibur ke rumah nenek, bukan mati."
    }
  ],
